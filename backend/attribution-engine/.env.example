# Database
DATABASE_URL=postgresql://creatorsync:creatorsync_dev_password@localhost:5432/creatorsync

# Redis
REDIS_URL=redis://localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# Elasticsearch
ELASTICSEARCH_URL=http://localhost:9200

# Platform API Keys
# YouTube
YOUTUBE_API_KEY=your_youtube_api_key_here

# TikTok
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here

# Instagram
INSTAGRAM_CLIENT_ID=your_instagram_client_id_here
INSTAGRAM_CLIENT_SECRET=your_instagram_client_secret_here

# Twitch
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Patreon
PATREON_CLIENT_ID=your_patreon_client_id_here
PATREON_CLIENT_SECRET=your_patreon_client_secret_here

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App Config
DEBUG=True
APP_NAME=CreatorSync Attribution Engine
APP_VERSION=1.0.0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ML Models
MODEL_PATH=./ml-models
ATTRIBUTION_MODEL_VERSION=v1.0
FORECAST_HORIZON_DAYS=90

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
