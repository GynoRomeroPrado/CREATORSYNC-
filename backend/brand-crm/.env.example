# Server
PORT=8003
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=creatorsync
DB_PASSWORD=creatorsync_dev_password
DB_NAME=creatorsync

# Redis
REDIS_URL=redis://localhost:6379/2

# External APIs
ATTRIBUTION_API_URL=http://localhost:8001

# DocuSign
DOCUSIGN_INTEGRATION_KEY=your_integration_key
DOCUSIGN_USER_ID=your_user_id
DOCUSIGN_ACCOUNT_ID=your_account_id
DOCUSIGN_PRIVATE_KEY_PATH=./docusign_private.key

# Email (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password

# JWT
JWT_SECRET=your-jwt-secret-key

# File Storage
MEDIA_KIT_STORAGE_PATH=./uploads/media-kits
CONTRACT_STORAGE_PATH=./uploads/contracts
