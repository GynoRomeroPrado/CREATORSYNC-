# Server
PORT=8004
DEBUG=True

# Database
DATABASE_URL=postgresql://creatorsync:creatorsync_dev_password@localhost:5432/creatorsync

# Redis
REDIS_URL=redis://localhost:6379/3

# Stripe (for payments)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Plaid (for bank verification)
PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ENV=sandbox

# KYC/AML
JUMIO_API_TOKEN=your_jumio_token
JUMIO_API_SECRET=your_jumio_secret

# Factoring Configuration
MIN_INVOICE_AMOUNT=500.0
MAX_INVOICE_AMOUNT=100000.0
MIN_ADVANCE_RATE=0.80
MAX_ADVANCE_RATE=0.95
DEFAULT_FACTOR_RATE=0.03
DEFAULT_DUE_DAYS=30

# Risk Assessment
MIN_RISK_SCORE=60
HIGH_RISK_THRESHOLD=70
LOW_RISK_THRESHOLD=85

# ML Models
MODEL_PATH=./ml-models/factoring
RISK_MODEL_VERSION=v1.0

# Collections
COLLECTION_REMINDER_DAYS=[7,3,1]
LATE_FEE_RATE=0.015

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Security
SECRET_KEY=change-this-secret-key
ALGORITHM=HS256

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
